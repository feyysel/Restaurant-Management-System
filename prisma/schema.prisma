generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  MANAGER
  KITCHEN
  WAITER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  COOKING
  READY
  SERVED
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  ACCEPTED
  COOKING
  READY
  SERVED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum BellStatus {
  RINGING
  RESPONDED
  DISMISSED
}

model User {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  passwordHash String
  role         Role
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  restaurantId String?
  restaurant   Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables       Table[]       @relation("TableWaiter")
  orders       Order[]       @relation("OrderWaiter")
  receipts     Receipt[]     @relation("ReceiptKitchen")
  notifications Notification[]
}

model Restaurant {
  id        String     @id @default(cuid())
  name      String
  address   String?
  phone     String?
  theme     String?
  createdAt DateTime   @default(now())
  users     User[]
  tables    Table[]
  categories Category[]
  menuItems MenuItem[]
  orders    Order[]
  receipts  Receipt[]
  notifications Notification[]
}

model Table {
  id           String   @id @default(cuid())
  number       Int
  code         String   @unique
  status       String   @default("free")
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  waiterId     String?
  waiter       User?    @relation("TableWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  orders       Order[]
  bellCalls    BellCall[]

  @@unique([restaurantId, number])
  @@index([waiterId])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  sortOrder    Int        @default(0)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@unique([restaurantId, name])
}

model MenuItem {
  id           String   @id @default(cuid())
  name         String
  description  String?
  ingredients  String
  price        Float
  imageUrl     String?
  available    Boolean  @default(true)
  isPopular    Boolean  @default(false)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  createdAt    DateTime @default(now())

  @@index([categoryId])
  @@index([restaurantId, categoryId])
  @@index([restaurantId, available])
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int
  type         OrderType   @default(DINE_IN)
  status       OrderStatus @default(PENDING)
  note         String?
  total        Float       @default(0)
  collectedAmount Float?
  tip          Float?
  tableId          String?
  table            Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  tableLabel       String?
  sourceTableCode  String?
  waiterId     String?
  waiter       User?       @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items        OrderItem[]
  receipt      Receipt?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status, createdAt])
  @@index([waiterId, status, createdAt])
  @@index([tableId, status])
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem?       @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  name       String
  price      Float
  quantity   Int
  status     OrderItemStatus @default(PENDING)

  @@index([orderId])
  @@index([menuItemId])
}

model Receipt {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items        String
  subtotal     Float
  tax          Float
  total        Float
  kitchenId    String?
  kitchen      User?    @relation("ReceiptKitchen", fields: [kitchenId], references: [id], onDelete: SetNull)
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  generatedAt  DateTime @default(now())

  @@index([restaurantId])
}

model BellCall {
  id          String     @id @default(cuid())
  tableId     String
  table       Table      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  status      BellStatus @default(RINGING)
  createdAt   DateTime   @default(now())
  resolvedAt  DateTime?
  respondedBy String?

  @@index([tableId, status])
}

model Notification {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role?
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  type         String
  title        String
  body         String
  read         Boolean  @default(false)
  orderId      String?
  tableId      String?
  createdAt    DateTime @default(now())

  @@index([restaurantId, createdAt])
  @@index([userId])
}
